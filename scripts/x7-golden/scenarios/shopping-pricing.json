        "value": {
          "subtotal_cents": 23700,
          "discount_cents": 0,
          "discount_label": "$0.00",
          "total_label": "$237.00",
          "pricing_status": "Member pricing runs inside a capability-scoped Rust sandbox."
        }
      }
    },
    {
