@keyframes loading_pulse {
  from {
    opacity: .42
  }
  to {
    opacity: .78
  }
}

.project_card, .task_card, .forecast_card, .focus_card, .activity_card, .form_card, .timeline_task {
  transition-property: transform, opacity
  transition-duration: 180ms, 180ms
  transition-timing-function: ease, ease
}
