project(id: "examples.minimal", version: "1.0.0")
variant default(include: ["*"])

model Hello { message: String }

cors(origins: ["http://localhost:5000", "http://127.0.0.1:5000"], methods: [GET], headers: ["accept", "content-type", "x-axiom-request-id", "x-axiom-cache-mode", "traceparent", "tracestate"], credentials: false, maxAge: 10m)

action hello(kind: ActionKind.query, output: Models.Hello) {
  managed { return {message: "Hello from Acore"} }
}
endpoint hello(method: GET, path: "/hello") {
  handle(action: Actions.hello)
  response(type: Models.Hello)
}
