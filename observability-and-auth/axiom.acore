profile backend 1

// Local synthetic auth fixture only. Backend independently verifies every protected request.
// Never put a production HMAC signing secret in a client contract.
amends "axiom-fastapi:./test_server.py:app"

project(id: "auth-obs-test", version: "1.0.0")

variant default(include: ["*"])

observability(enabled: true, telemetryUrl: "http://localhost:4318/v1/traces", sampleRate: 1.0)

override endpoint Routes.protected_jwt {
  auth(EndpointAuth(
      required: true,
      scopes: ["items:read"],
      methods: [
        AuthMethodDef(
          type: "bearer",
          name: "Authorization",
          scheme: "Bearer",
          location: "header",
          validation: AuthValidationDef(strategy: "jwt", secret: "development-only-placeholder-auth-fixture-key-2026", alg: "HS256")
        )
      ]
    ))
}

override endpoint Routes.protected_api_key_header {
  auth(EndpointAuth(required: true, methods: [AuthMethodDef(type: "api_key", name: "x-api-key", location: "header")]))
}

override endpoint Routes.protected_api_key_query {
  auth(EndpointAuth(required: true, methods: [AuthMethodDef(type: "api_key", name: "api_key", location: "query")]))
}

override endpoint Routes.protected_multi {
  auth(EndpointAuth(
      required: true,
      condition: "or",
      methods: [
        AuthMethodDef(type: "bearer", name: "Authorization", scheme: "Bearer", location: "header"),
        AuthMethodDef(type: "api_key", name: "x-api-key", location: "header")
      ]
    ))
}
