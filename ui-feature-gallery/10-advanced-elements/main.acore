module phase2.advanced.overlay.ui

styles {
  .screen {
    width: 100%
    min-height: 100vh
    padding: 20px
    background-color: #f4f6fb
  }

  .button {
    width: 100%
    min-height: 44px
    padding: 10px
    background-color: #244fc7
    color: white
  }

  .overlay {
    position: fixed
    overflow: visible
  }

  .backdrop {
    width: 100%
    height: 100%
    padding: 32px
    background-color: rgba(0, 0, 0, 0.55)
    justify-content: center
    align-items: center
    z-index: 0
  }

  .dialog {
    width: 100%
    padding: 20px
    background-color: white
    color: #172033
  }
}

app AdvancedOverlay {
  route "/" => Home
}

page Home {
  state overlay_visible: Bool = false
  state status: String = "Overlay is closed"

  action open_overlay() {
    overlay_visible = true
    status = "Overlay opening"
  }

  action close_overlay() {
    overlay_visible = false
    status = "Overlay closing"
  }

  action shown() {
    status = "Overlay shown"
  }

  action dismissed() {
    status = "Overlay dismissed"
  }

  action touched() {
    status = "Overlay touch delivered"
  }

  view {
    SafeArea(class: "screen") {
      Text("UI advanced elements")
      Text(status)
      Button(label: "Open overlay", class: "button", on_press: open_overlay)
      Overlay(
        class: "overlay",
        visible: overlay_visible,
        level: 1,
        on_show: shown,
        on_dismiss: dismissed,
        on_overlay_touch: touched,
        accessibility_label: "UI dialog"
      ) {
        View(class: "backdrop") {
          View(class: "dialog") {
            Text("Explicitly styled overlay")
            Button(label: "Close", class: "button", on_press: close_overlay)
          }
        }
      }
    }
  }
}
