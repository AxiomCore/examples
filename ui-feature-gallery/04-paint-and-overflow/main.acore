module phase2.paint.overflow.ui

styles {
  variables {
    ink: #10223a
    accent: #48c4ee
    edge: 2px
  }

  Page {
    min-height: 100vh
    background-color: #f4f7fb
  }

  .screen {
    display: flex
    flex-direction: column
    gap: 14px
    padding: 16px
    box-sizing: border-box
    width: 100%
  }

  .hero {
    height: 112px
    padding: 16px
    background-image: linear-gradient(135deg, #10223a, #1e6a8a), radial-gradient(circle, #78d6ff, transparent)
    background-position: center, right top
    background-size: cover, 72px 72px
    background-repeat: no-repeat, no-repeat
    border: var(edge) solid var(accent)
    border-radius: 8px 22px / 12px 26px
    box-shadow: 0 6px 12px rgba(16, 34, 58, .25)
    color: #ffffff
  }

  .clip_stage {
    width: 100%
    height: 72px
    overflow: hidden
    border-width: 2px 4px
    border-style: solid dashed
    border-color: #10223a #48c4ee
    border-radius: 14px
  }

  .overflow_child {
    width: 140%
    height: 72px
    background: linear-gradient(90deg, #78d6ff, #f59e0b)
    clip-path: inset(4px)
  }

  .mask_sample {
    width: 100%
    height: 56px
    background-color: #1e6a8a
    mask-image: linear-gradient(90deg, transparent, #000, transparent)
  }

  .transparent_group {
    padding: 10px
    background-color: #f59e0b
    opacity: 55%
  }

  .hidden_but_laid_out {
    height: 18px
    visibility: hidden
  }

  .after_hidden {
    border-bottom: 3px solid #48c4ee
    padding-bottom: 4px
    color: var(ink)
  }
}

app Phase2Paint { route "/" => PaintGallery }

page PaintGallery {
  view {
    SafeArea {
      View(class: "screen") {
        View(class: "hero") { Text("UI · authored paint") }
        View(class: "clip_stage") {
          View(class: "overflow_child") { Text("The right side is clipped") }
        }
        View(class: "mask_sample") { Text("Gradient mask") }
        View(class: "transparent_group") { Text("Whole-group opacity") }
        View(class: "hidden_but_laid_out") { Text("Invisible, but layout remains") }
        View(class: "after_hidden") { Text("Hit testing is validated separately") }
      }
    }
  }
}
