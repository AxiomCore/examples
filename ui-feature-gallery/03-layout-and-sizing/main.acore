module phase2.layout.sizing.ui

styles {
  variables {
    page_padding: 16px
    section_gap: 12px
    card_height: 92px
    layout_mode: flex
  }

  Page {
    min-height: 100vh
    background-color: #f4f7fb
  }

  .screen {
    display: var(layout_mode)
    box-sizing: border-box
    width: 100%
    min-height: 100vh
    flex-flow: column nowrap
    align-items: stretch
    padding: var(page_padding)
    gap: var(section_gap)
  }

  .header {
    display: flex
    flex-direction: row
    justify-content: space-between
    align-items: center
    width: 100%
    height: 48px
  }

  .title {
    color: #10223a
    font-size: 22px
  }

  .counter {
    width: 44px
    height: 28px
    padding: 4px 8px
    box-sizing: border-box
    background-color: #dcecff
    border-radius: 8px
    color: #10223a
  }

  .grid {
    display: grid
    width: 100%
    grid-template-columns: repeat(2, 1fr)
    grid-auto-rows: minmax(var(card_height), auto)
    gap: var(section_gap)
    align-items: stretch
    justify-items: stretch
  }

  .card {
    display: flex
    flex-direction: column
    justify-content: center
    min-width: 0
    min-height: var(card_height)
    padding: 12px
    box-sizing: border-box
    background-color: #ffffff
    border-radius: 10px
    color: #10223a
  }

  .wide {
    grid-column: 1 / span 2
    aspect-ratio: 4 / 1
  }

  .linear_strip {
    display: linear
    linear-direction: row
    justify-content: space-between
    linear-cross-gravity: center
    width: 100%
    height: 44px
    padding-inline-start: 10px
    padding-inline-end: 10px
    background-color: #dcecff
  }

  .footer {
    display: flex
    flex-direction: row
    justify-content: center
    margin-top: 4px
    width: 100%
  }
}

app Phase2Layout {
  route "/" => LayoutGallery
}

page LayoutGallery {
  view {
    SafeArea {
      View(class: "screen") {
        View(class: "header") {
          Text("UI layout", class: "title")
          Text("82", class: "counter")
        }
        View(class: "grid") {
          View(class: "card") { Text("Flex card A") }
          View(class: "card") { Text("Flex card B") }
          View(class: "card wide") { Text("Grid span 2 · aspect 4/1") }
        }
        View(class: "linear_strip") {
          Text("Linear start")
          Text("Linear end")
        }
        View(class: "footer") {
          Text("All spacing and sizing above is authored")
        }
      }
    }
  }
}
