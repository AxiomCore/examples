@import "tokens.acss"

.topbar, .brand_lockup {
  display: flex
  flex-direction: row
  align-items: center
}

.topbar {
  justify-content: space-between
  width: 100%
  min-height: 42px
}

.brand_lockup {
  gap: 10px
}

.brand_mark {
  width: 34px
  height: 34px
  padding: 7px
  box-sizing: border-box
  background-color: var(ink)
  border-radius: 11px
  color: var(acid)
  font-size: 17px
  font-weight: 700
  text-align: center
}

.brand {
  color: var(ink)
  font-size: 18px
  font-weight: 700
  letter-spacing: 2.5px
}

.brand_note {
  color: var(muted)
  font-size: 10px
  letter-spacing: 1px
}

.bag {
  min-height: 34px
  padding: 9px 14px
  background-color: var(ink)
  border-radius: 17px
  color: #ffffff
  font-size: 11px
  font-weight: 700
  letter-spacing: .7px
}

viewport compact {
  .topbar {
    min-height: 38px
  }

  .brand_lockup {
    gap: 8px
  }

  .brand_mark {
    width: 30px
    height: 30px
    padding: 6px
    border-radius: 9px
    font-size: 15px
  }

  .brand {
    font-size: 16px
  }

  .brand_note {
    display: none
  }

  .bag {
    min-height: 30px
    padding: 8px 11px
    font-size: 10px
  }
}
