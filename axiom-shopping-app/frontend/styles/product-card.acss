@import "tokens.acss"

.product {
  min-height: 136px
  padding: 13px
  gap: 4px
  background-color: var(paper)
  border-width: 1px
  border-style: solid
  border-color: var(line)
  border-radius: 17px
  box-shadow: 0 5px 14px rgba(23, 32, 28, .06)
}

.product_top {
  display: flex
  flex-direction: row
  justify-content: space-between
  align-items: center
  width: 100%
}

.product_icon {
  width: 38px
  height: 38px
  padding: 7px
  box-sizing: border-box
  background-image: linear-gradient(145deg, var(acid), #f0ffc8)
  border-radius: 12px
  color: var(forest)
  font-size: 18px
  font-weight: 700
  text-align: center
}

.product_badge {
  color: var(coral)
  font-size: 9px
  font-weight: 700
  letter-spacing: 1.1px
}

.product_name {
  color: var(ink)
  font-size: 15px
  font-weight: 700
}

.product_copy {
  color: var(muted)
  font-size: 10px
  line-height: 14px
}

.product_price {
  color: var(ink)
  font-size: 14px
  font-weight: 700
}

viewport compact {
  .product {
    min-height: 122px
    padding: 12px
    gap: 0px
    border-radius: 15px
  }

  .product_icon {
    width: 32px
    height: 32px
    padding: 6px
    border-radius: 10px
    font-size: 16px
  }

  .product_name, .product_copy, .product_price {
    margin-top: 6px
  }
}
