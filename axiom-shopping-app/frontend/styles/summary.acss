@import "tokens.acss"

.summary {
  box-sizing: border-box
}

.summary {
  padding: 14px
  gap: 7px
  background-color: var(paper)
  border-width: 1px
  border-style: solid
  border-color: var(line)
  border-radius: 18px
  box-shadow: 0 8px 22px rgba(23, 32, 28, .08)
  overflow: hidden
}

.summary_actions {
  display: flex
  flex-direction: row
  align-items: center
  gap: 8px
  width: 100%
}

.member_button, .checkout_button {
  width: 50%
  min-height: 38px
  padding: 10px
  border-radius: 12px
  font-size: 11px
  font-weight: 700
}

.member_button {
  background-color: var(acid)
  color: var(forest)
}

.checkout_button {
  display: flex
  flex-direction: row
  justify-content: center
  align-items: center
  background-color: var(ink)
  color: #ffffff
}

.checkout_button_label {
  color: #ffffff
  font-size: 11px
  font-weight: 700
}

.checkout_spinner {
  width: 20px
  height: 20px
  box-sizing: border-box
  border-width: 2px
  border-style: solid
  border-color: rgba(255, 255, 255, .28)
  border-top-color: #ffffff
  border-radius: 50%
  transform-origin: center center
  animation: checkout_spinner_turn 700ms linear 0s infinite normal both running
}
